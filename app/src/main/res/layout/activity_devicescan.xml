<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/gradient_background">

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="100dp"
        android:background="@drawable/gradient_background">

        <TextView
            android:layout_width="match_parent"
            android:text="Devices"
            android:layout_height="@dimen/_28sdp"
            android:layout_marginTop="42dp"
            android:background="@color/colorClear"
            android:textColor="#ffffff"
            android:includeFontPadding="false"
            android:fontFamily="@font/dmsans_semibold"
            android:gravity="center"
            android:textSize="@dimen/_15sdp"
            />

        <ImageView
            android:id="@+id/ivBack"
            android:layout_width="50dp"
            android:layout_height="50dp"
            android:layout_marginTop="39dp"
            android:layout_marginStart="24dp"
            android:src="@drawable/arrow"/>


        <Button
            android:layout_width="@dimen/_38sdp"
            android:layout_height="match_parent"
            android:layout_gravity="left"
            android:onClick="backAction"
            android:background="@color/colorClear"/>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginTop="100dp"
            android:background="#AAAAAA"/>

    </FrameLayout>

    <androidx.cardview.widget.CardView
        android:layout_width="200dp"
        android:layout_height="200dp"
        android:layout_gravity="center"
        app:cardCornerRadius="100dp"
        app:cardBackgroundColor="@android:color/transparent"
        app:cardElevation="0dp"
        >


        <View
            android:id="@+id/pulse_circle1"
            android:layout_width="150dp"
            android:layout_height="150dp"
            android:padding="@dimen/_15sdp"
            android:layout_gravity="center"
            android:alpha="0.6"
            android:background="@drawable/red_circle_background" />

        <View
            android:id="@+id/pulse_circle2"
            android:layout_width="130dp"
            android:layout_height="130dp"
            android:alpha="0.7"
            android:padding="@dimen/_15sdp"
            android:layout_gravity="center"
            android:background="@drawable/red_circle_background" />

        <View
            android:id="@+id/pulse_circle3"
            android:layout_width="100dp"
            android:layout_height="100dp"
            android:alpha="1.0"
            android:layout_gravity="center"
            android:background="@drawable/red_circle_background" />

        <ImageView
            android:id="@+id/bluetooth_icon"
            android:layout_width="70dp"
            android:layout_height="70dp"
            android:layout_gravity="center"
            android:padding="20dp"
            android:background="@drawable/red_circle"
            android:src="@drawable/ic_bluetooth"
            android:scaleType="fitCenter" />


    </androidx.cardview.widget.CardView>


    <TextView
        android:id="@+id/tv_searching"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Searching For Devices..."
        android:textSize="@dimen/_20sdp"
        android:layout_gravity="center"
        android:fontFamily="@font/dmsans_semibold"
        android:textColor="@color/dialog_white"
        />
    <FrameLayout
        android:id="@+id/custom_progress_bar"
        android:layout_width="match_parent"
        android:layout_height="10dp"
        android:layout_marginTop="@dimen/_15sdp"
        android:background="@drawable/progress_track_bg"
        android:layout_marginHorizontal="@dimen/_15sdp"
        android:clipToOutline="true">



        <View
            android:id="@+id/progress_fill"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:background="@drawable/progress_bg" />

    </FrameLayout>
    <androidx.cardview.widget.CardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:cardCornerRadius="10dp"
        android:layout_marginHorizontal="@dimen/_10sdp"
        app:cardBackgroundColor="@android:color/transparent"
        app:cardElevation="0dp" >


<!--    <SeekBar-->
<!--        android:layout_width="match_parent"-->
<!--        android:layout_height="wrap_content"-->
<!--        />-->

    </androidx.cardview.widget.CardView>

    <ListView
        android:id="@+id/devicescan_list"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        tools:listitem="@layout/device_list_item"
        android:backgroundTint="@color/transparent"
        android:layout_marginTop="@dimen/_5sdp"
        android:layout_marginHorizontal="@dimen/_15sdp"
        android:scrollbars="none">
    </ListView>
    <!--        android:dividerHeight="1dp"-->

    <!--        android:divider="#CCCCCC"-->
</LinearLayout>