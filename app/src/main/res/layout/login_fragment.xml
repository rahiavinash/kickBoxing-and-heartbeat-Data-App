<?xml version="1.0" encoding="utf-8"?>

<androidx.constraintlayout.widget.ConstraintLayout xmlns:tools="http://schemas.android.com/tools"
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/gradient_background"
    tools:context=".Activitys.presentation.Ui.auth.LoginFragment"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
            xmlns:tools="http://schemas.android.com/tools"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            xmlns:app="http://schemas.android.com/apk/res-auto"
            android:orientation="vertical"
            tools:context=".Activitys.presentation.Ui.auth.LoginFragment">

            <ImageView
                android:id="@+id/img_logo"
                android:layout_width="@dimen/_130sdp"
                android:layout_height="@dimen/_130sdp"
                android:layout_marginTop="@dimen/_38sdp"
                android:layout_gravity="center"
                android:src="@drawable/app_logo"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/login_acc"
                android:textSize="@dimen/_18sdp"
                android:layout_gravity="center"
                android:fontFamily="@font/dmsans_semibold"
                android:textColor="@color/dialog_white"
                android:layout_marginTop="@dimen/_24sdp"
                />
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/email_address"
                android:fontFamily="@font/dmsans_semibold"
                android:textColor="@color/dialog_white"
                android:layout_marginStart="@dimen/_20sdp"
                android:layout_marginTop="@dimen/_40sdp"
                android:textSize="@dimen/_11sdp"
                />

            <EditText
                android:id="@+id/etEmail"
                android:layout_width="match_parent"
                android:layout_height="@dimen/_43sdp"
                android:layout_marginStart="@dimen/_20sdp"
                android:layout_marginEnd="@dimen/_11sdp"
                android:textColorHint="@color/et_gray"
                android:textColor="@color/dialog_white"
                android:textSize="@dimen/_12sdp"
                android:maxLines="1"
                android:singleLine="true"
                android:fontFamily="@font/dmsans_semibold"
                android:background="@drawable/edit_text_background"
                android:hint="@string/enter_email_address"
                android:layout_marginTop="@dimen/_7sdp"
                android:padding="@dimen/_11sdp"
                />
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/password"
                android:textColor="@color/dialog_white"
                android:textSize="@dimen/_11sdp"
                android:fontFamily="@font/dmsans_semibold"
                android:layout_marginStart="@dimen/_20sdp"
                android:layout_marginTop="@dimen/_19sdp"
                />

            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/etPasswordLayout"
                android:layout_width="match_parent"
                android:layout_height="@dimen/_43sdp"
                android:background="@drawable/edit_text_background"
                android:layout_marginStart="@dimen/_20sdp"
                android:layout_marginEnd="@dimen/_11sdp"
                android:layout_marginTop="@dimen/_7sdp"
                app:passwordToggleEnabled="false"
                app:passwordToggleTint="@color/dialog_white">


                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/etPassword"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:fontFamily="@font/dmsans_semibold"
                        android:hint="@string/enter_your_password"
                        android:inputType="textPassword"
                        android:textColor="@color/dialog_white"
                        android:textColorHint="@color/et_gray"
                        android:textSize="@dimen/_12sdp" />

                    <ImageView
                        android:id="@+id/passwordToggle"
                        android:layout_width="@dimen/_25sdp"
                        android:layout_height="@dimen/_25sdp"
                        android:src="@drawable/ic_eye_off"
                        android:padding="@dimen/_4sdp"
                        android:clickable="true"
                        android:focusable="true"
                        android:layout_marginEnd="@dimen/_10sdp"
                        />

                </LinearLayout>
            </com.google.android.material.textfield.TextInputLayout>



            <TextView
                android:id="@+id/tvForgotPassword"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/forgot_password"
                android:textColor="@color/light_gray"
                android:textSize="@dimen/_12sdp"
                android:fontFamily="@font/dmsans_regular"
                android:textStyle="bold"
                android:layout_margin="@dimen/_16sdp"
                android:layout_gravity="end"
                />

            <Button
                android:id="@+id/btLogin"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:paddingVertical="@dimen/_13sdp"
                android:layout_marginHorizontal="@dimen/_23sdp"
                android:layout_marginTop="@dimen/_25sdp"
                android:text="@string/login"
                android:textSize="@dimen/_12sdp"
                android:fontFamily="@font/dmsans_semibold"
                android:backgroundTint="@color/colorRed"
                android:textColor="@color/dialog_white" />

            <TextView
                android:id="@+id/tvSignUp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/alertdialog_line"
                android:textSize="@dimen/_12sdp"
                android:fontFamily="@font/dmsans_medium"
                android:layout_marginTop="@dimen/_35sdp"
                android:layout_gravity="center"
                />
        </LinearLayout>

    </ScrollView>
</androidx.constraintlayout.widget.ConstraintLayout>
