<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <data>

    </data>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/gradient_background">

        <LinearLayout
            android:id="@+id/fragment_create_profile"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:orientation="vertical"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            android:layout_marginTop="@dimen/_9sdp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/ivBack"
            tools:context=".Activitys.presentation.Ui.auth.CreateProfileFragment">

            <ScrollView
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <LinearLayout
                    android:layout_width="match_parent"
                    android:paddingTop="@dimen/_8sdp"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">
                    <TextView
                        android:id="@+id/kickBoxing_title"
                        android:layout_width="match_parent"
                        android:layout_height="@dimen/_39sdp"
                        android:gravity="center"
                        android:fontFamily="@font/dmsans_semibold"
                        android:text="@string/kickBoxing"
                        android:textColor="@color/dialog_white"
                        android:textSize="@dimen/_16sdp"
                         />

                    <androidx.constraintlayout.widget.ConstraintLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:padding="@dimen/_11sdp">


                        <de.hdodenhof.circleimageview.CircleImageView
                            android:id="@+id/img_profile"
                            android:layout_width="@dimen/_88sdp"
                            android:layout_height="@dimen/_88sdp"
                            android:layout_gravity="center_horizontal"
                            android:background="@drawable/image_background"
                            android:src="@drawable/image"
                            app:layout_constraintBottom_toBottomOf="parent"
                            app:layout_constraintEnd_toEndOf="parent"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintTop_toTopOf="parent" />

                        <ImageView
                            android:id="@+id/editImage"
                            android:layout_width="@dimen/_27sdp"
                            android:layout_height="@dimen/_27sdp"
                            android:layout_marginTop="@dimen/_47sdp"
                            android:src="@drawable/edit_image"
                            app:layout_constraintBottom_toBottomOf="@+id/img_profile"
                            app:layout_constraintEnd_toEndOf="@+id/img_profile" />

                    </androidx.constraintlayout.widget.ConstraintLayout>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/_20sdp"
                        android:layout_marginTop="@dimen/_11sdp"
                        android:text="@string/userName"
                        android:textColor="@color/dialog_white"
                        android:textSize="@dimen/_11sdp"
                        android:fontFamily="@font/dmsans_semibold" />

                    <EditText
                        android:id="@+id/usernameEditText"
                        android:layout_width="match_parent"
                        android:layout_height="@dimen/_43sdp"
                        android:layout_marginStart="@dimen/_20sdp"
                        android:layout_marginTop="@dimen/_8sdp"
                        android:layout_marginEnd="@dimen/_11sdp"
                        android:maxLength="15"
                        android:textColor="@color/dialog_white"
                        android:background="@drawable/edit_text_background"
                        android:hint="@string/enter_username"
                        android:singleLine="true"
                        android:padding="@dimen/_11sdp"
                        android:fontFamily="@font/dmsans_semibold"
                        android:textColorHint="@color/dialog_gray" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/_20sdp"
                        android:layout_marginTop="@dimen/_11sdp"
                        android:text="@string/fullname"
                        android:fontFamily="@font/dmsans_semibold"
                        android:textColor="@color/dialog_white"
                        android:textSize="@dimen/_11sdp"
                      />

                    <EditText
                        android:id="@+id/fullNameEditText"
                        android:layout_width="match_parent"
                        android:layout_height="@dimen/_43sdp"
                        android:layout_marginStart="@dimen/_20sdp"
                        android:layout_marginTop="@dimen/_8sdp"
                        android:layout_marginEnd="@dimen/_11sdp"
                        android:textColor="@color/dialog_white"
                        android:singleLine="true"
                        android:maxLength="15"
                        android:background="@drawable/edit_text_background"
                        android:hint="@string/enter_fullname"
                        android:fontFamily="@font/dmsans_semibold"
                        android:padding="@dimen/_11sdp"
                        android:textColorHint="@color/dialog_gray" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/_20sdp"
                        android:layout_marginTop="@dimen/_11sdp"
                        android:text="@string/DOB"
                        android:textColor="@color/dialog_white"
                        android:textSize="@dimen/_11sdp"
                        android:fontFamily="@font/dmsans_semibold" />

                    <androidx.compose.ui.platform.ComposeView
                        android:id="@+id/date_picker_compose"
                        android:layout_width="match_parent"
                        android:layout_height="@dimen/_43sdp"
                        android:layout_marginStart="@dimen/_20sdp"
                        android:layout_marginTop="@dimen/_8sdp"
                        android:layout_marginEnd="@dimen/_11sdp"/>


                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/_20sdp"
                        android:layout_marginTop="@dimen/_11sdp"
                        android:text="@string/gender"
                        android:textColor="@color/dialog_white"
                        android:textSize="@dimen/_11sdp"
                        android:fontFamily="@font/dmsans_semibold" />

                    <androidx.compose.ui.platform.ComposeView
                        android:id="@+id/composeGenderDropDown"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:layout_marginStart="@dimen/_20sdp"
                        android:layout_marginTop="@dimen/_8sdp"
                        android:layout_marginEnd="@dimen/_11sdp"/>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/_20sdp"
                        android:layout_marginTop="@dimen/_11sdp"
                        android:text="@string/height"
                        android:textColor="@color/dialog_white"
                        android:textSize="@dimen/_11sdp"
                        android:fontFamily="@font/dmsans_semibold" />

                    <EditText
                        android:id="@+id/heightEditText"
                        android:layout_width="match_parent"
                        android:layout_height="@dimen/_43sdp"
                        android:layout_marginStart="@dimen/_20sdp"
                        android:layout_marginTop="@dimen/_8sdp"
                        android:layout_marginEnd="@dimen/_11sdp"
                        android:background="@drawable/edit_text_background"
                        android:fontFamily="@font/dmsans_semibold"
                        android:hint="@string/enter_height"
                        android:padding="@dimen/_11sdp"
                        android:singleLine="true"
                        android:focusable="false"
                        android:cursorVisible="false"
                        android:inputType="none"
                        android:textColor="@color/dialog_white"
                        android:textColorHint="@color/dialog_gray" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/_20sdp"
                        android:layout_marginTop="@dimen/_11sdp"
                        android:text="@string/weight"
                        android:textColor="@color/dialog_white"
                        android:textSize="@dimen/_11sdp"
                        android:fontFamily="@font/dmsans_semibold" />

            <EditText
                android:id="@+id/weightEditText"
                android:layout_width="match_parent"
                android:layout_height="@dimen/_43sdp"
                android:layout_marginStart="@dimen/_20sdp"
                android:layout_marginTop="@dimen/_8sdp"
                android:layout_marginEnd="@dimen/_11sdp"
                android:textColor="@color/dialog_white"
                android:fontFamily="@font/dmsans_semibold"
                android:singleLine="true"
                android:background="@drawable/edit_text_background"
                android:hint="@string/enter_weight"
                android:padding="@dimen/_11sdp"
                android:focusable="false"
                android:cursorVisible="false"
                android:inputType="textMultiLine|textNoSuggestions"
                android:textColorHint="@color/dialog_gray" />

                    <Button
                        android:id="@+id/btSubmit"
                        android:layout_width="match_parent"
                        android:layout_height="@dimen/_44sdp"
                        android:layout_gravity="center"
                        android:layout_marginHorizontal="@dimen/_20sdp"
                        android:layout_marginTop="@dimen/_32sdp"
                        android:layout_marginBottom="@dimen/_62sdp"
                        android:backgroundTint="@color/colorRed"
                        android:text="@string/submit"
                        android:textColor="@color/dialog_white"
                        android:textSize="@dimen/_13sdp" />
                </LinearLayout>

            </ScrollView>


        </LinearLayout>

        <ImageView
            android:id="@+id/ivBack"
            android:layout_width="@dimen/_43sdp"
            android:layout_height="@dimen/_43sdp"
            android:layout_marginStart="@dimen/_15sdp"
            android:layout_marginTop="@dimen/_30sdp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            android:src="@drawable/arrow"/>

        <TextView
            android:id="@+id/boxing_text_title"
            android:layout_width="wrap_content"
            android:layout_height="@dimen/_28sdp"
            android:fontFamily="@font/dmsans_semibold"
            android:gravity="center"
            android:text="@string/create_profile"
            android:textColor="@color/dialog_white"
            android:textSize="@dimen/_19sdp"
            app:layout_constraintBottom_toBottomOf="@+id/ivBack"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="@+id/ivBack" />
    </androidx.constraintlayout.widget.ConstraintLayout>

</layout>

