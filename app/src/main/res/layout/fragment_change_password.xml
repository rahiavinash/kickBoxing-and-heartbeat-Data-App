<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@drawable/gradient_background"
    tools:context=".Activitys.presentation.Ui.auth.ChangePasswordFragment">

    <ImageView
        android:id="@+id/ivBackReset"
        android:layout_width="@dimen/_43sdp"
        android:layout_height="@dimen/_43sdp"
        android:layout_marginTop="@dimen/_30sdp"
        android:layout_marginStart="@dimen/_15sdp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        android:src="@drawable/arrow"/>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintTop_toBottomOf="@id/ivBackReset"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/_89sdp"
            android:orientation="vertical"
            >

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/reset_password"
                android:textSize="25sp"

                android:fontFamily="@font/dmsans_semibold"
                android:layout_gravity="center"
                android:textColor="@color/dialog_white"
                />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/new_password"
                android:textColor="@color/dialog_white"
                android:textSize="@dimen/_11sdp"
                android:fontFamily="@font/dmsans_semibold"
                android:layout_marginStart="@dimen/_19sdp"
                android:layout_marginTop="@dimen/_45sdp"
                />


            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/etPasswordLayoutSignUp"
                android:layout_width="match_parent"
                android:layout_height="@dimen/_42sdp"
                android:background="@drawable/edit_text_background"
                android:layout_marginStart="@dimen/_20sdp"
                android:layout_marginEnd="@dimen/_11sdp"
                android:layout_marginTop="@dimen/_8sdp"
                app:passwordToggleEnabled="false"
                app:passwordToggleTint="@color/dialog_white">


                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/etPasswordChange"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:textColor="@color/dialog_white"
                        android:fontFamily="@font/dmsans_semibold"
                        android:hint="@string/enter_your_new_password"
                        android:inputType="textPassword"
                        android:textColorHint="@color/et_gray"
                        android:textSize="@dimen/_11sdp" />

                    <ImageView
                        android:id="@+id/passwordToggle"
                        android:layout_width="@dimen/_25sdp"
                        android:layout_height="@dimen/_25sdp"
                        android:src="@drawable/ic_eye_off"
                        android:padding="@dimen/_4sdp"
                        android:clickable="true"
                        android:focusable="true"
                        android:layout_marginEnd="@dimen/_10sdp"
                        />

                </LinearLayout>
            </com.google.android.material.textfield.TextInputLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/confirm_new_password"
                android:textColor="@color/dialog_white"
                android:textSize="@dimen/_11sdp"
                android:fontFamily="@font/dmsans_semibold"
                android:layout_marginStart="@dimen/_20sdp"
                android:layout_marginTop="@dimen/_15sdp"
                />

            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/etPasswordLayout"
                android:layout_width="match_parent"
                android:layout_height="@dimen/_42sdp"
                android:background="@drawable/edit_text_background"
                android:layout_marginStart="@dimen/_20sdp"
                android:layout_marginEnd="@dimen/_11sdp"
                android:layout_marginTop="@dimen/_8sdp"
                app:passwordToggleEnabled="false"
                app:passwordToggleTint="@color/dialog_white">


                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/etPasswordConfirmPass"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:fontFamily="@font/dmsans_semibold"
                        android:hint="@string/enter_your_confirm_password"
                        android:inputType="textPassword"
                        android:textColor="@color/dialog_white"
                        android:textColorHint="@color/et_gray"
                        android:textSize="@dimen/_11sdp" />

                    <ImageView
                        android:id="@+id/passwordToggleConfirmPass"
                        android:layout_width="@dimen/_25sdp"
                        android:layout_height="@dimen/_25sdp"
                        android:src="@drawable/ic_eye_off"
                        android:padding="@dimen/_4sdp"
                        android:clickable="true"
                        android:focusable="true"
                        android:layout_marginEnd="@dimen/_10sdp"
                        />

                </LinearLayout>
            </com.google.android.material.textfield.TextInputLayout>

            <Button
                android:id="@+id/btChangePassword"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/reset_password"
                android:fontFamily="@font/dmsans_semibold"
                android:layout_marginTop="@dimen/_31sdp"
                android:textSize="16sp"
                android:paddingVertical="@dimen/_13sdp"
                android:layout_marginHorizontal="@dimen/dp_30"
                android:backgroundTint="@color/colorRed"
                android:textColor="@color/dialog_white"
                android:layout_gravity="center"
                />

        </LinearLayout>
    </ScrollView>

</androidx.constraintlayout.widget.ConstraintLayout>