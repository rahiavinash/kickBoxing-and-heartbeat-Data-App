<!-- res/drawable/rounded_seekbar_progress.xml -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:id="@android:id/background">
        <shape>
            <corners android:radius="15dp" /> <!-- Adjust the radius to make the corners more or less rounded -->
            <solid android:color="@color/gray" /> <!-- Background color when no progress -->
        </shape>
    </item>
    <item android:id="@android:id/progress">
        <clip>
            <shape>
                <corners android:radius="15dp" /> <!-- Adjust the radius to make the corners more or less rounded -->
                <solid android:color="@color/colorRed" /> <!-- The color of the progress bar -->
            </shape>
        </clip>
    </item>
</layer-list>