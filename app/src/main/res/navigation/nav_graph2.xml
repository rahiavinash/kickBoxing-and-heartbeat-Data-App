<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/nav_graph2"
    app:startDestination="@id/homesFragment">

    <fragment
        android:id="@+id/FirstFragment"
        android:name="com.app.kickboxing.Activitys.presentation.Ui.Activities.FirstFragment"
        android:label="@string/first_fragment_label"
        tools:layout="@layout/fragment_first" >

        <action
            android:id="@+id/action_FirstFragment_to_SecondFragment"
            app:destination="@id/SecondFragment" />
        <action
            android:id="@+id/action_FirstFragment_to_heart_beat_fragment"
            app:destination="@id/heart_beat_fragment" />
    </fragment>
    <fragment
        android:id="@+id/SecondFragment"
        android:name="com.app.kickboxing.Activitys.presentation.Ui.Activities.SecondFragment"
        android:label="@string/second_fragment_label"
        tools:layout="@layout/fragment_second" >

        <action
            android:id="@+id/action_SecondFragment_to_FirstFragment"
            app:destination="@id/FirstFragment" />
    </fragment>
    <fragment
        android:id="@+id/homesFragment"
        android:name="com.app.kickboxing.Activitys.presentation.Ui.Activities.HomesFragment"
        android:label="fragment_homes"
        tools:layout="@layout/fragment_homes" >
        <action
            android:id="@+id/action_homesFragment_to_FirstFragment"
            app:destination="@id/FirstFragment" />
    </fragment>

    <fragment
        android:id="@+id/trackingFragment"
        android:name="com.app.kickboxing.Activitys.presentation.Ui.TrackingFragment"
        android:label="fragment_turn_by_turn_navigation"
        tools:layout="@layout/fragment_tracking" />
    <fragment
        android:id="@+id/heart_beat_fragment"
        android:name="com.app.kickboxing.Activitys.presentation.Ui.Activities.HeartBeatFragment"
        android:label="fragment_turn_by_turn_navigation"
        tools:layout="@layout/fragment_heart_beat" />
</navigation>