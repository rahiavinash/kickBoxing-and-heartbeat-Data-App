<resources>

    <style name="AppThemes" parent="Theme.AppCompat.NoActionBar">
        <item name="colorPrimary">@color/colorPrimary</item>
        <item name="colorPrimaryDark">@color/colorPrimaryDark</item>
        <item name="colorAccent">@color/colorAccent</item>


    </style>

    <style name="CustomDatePickerDialogTheme" parent="Theme.AppCompat.Light.Dialog">
        <item name="colorAccent">@color/colorRed</item> <!-- Green highlight -->
        <item name="android:colorControlActivated">@color/colorRed</item>
        <item name="android:background">#1E1E1E</item> <!-- Dialog background -->
        <item name="android:textColorPrimary">#FFFFFF</item> <!-- Date numbers -->
        <item name="android:textColorSecondary">#CCCCCC</item>
        <item name="android:buttonBarButtonStyle">@style/CustomButtonStyle</item>
    </style>

    <style name="CustomButtonStyle" parent="android:Widget.Material.Button">
        <item name="android:textColor">@color/dialog_black</item> <!-- Button color -->
    </style>

</resources>
